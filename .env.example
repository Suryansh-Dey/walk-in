# AI, through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# PayPal sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Shown in setup as a one-click sandbox seller for the sample shops
DEMO_MERCHANT_EMAIL=

# Only needed behind a CDN. Otherwise the origin comes from the request.
PUBLIC_BASE_URL=

# Storage. DYNAMODB_ENDPOINT points at a local DynamoDB for development.
TABLE_NAME=walk-in
DYNAMODB_ENDPOINT=http://localhost:8000

# Set by the deployment. When empty, imports run inside the web process.
IMPORTER_FUNCTION=

# Local development and sandbox demos only
ALLOW_PRIVATE_FETCH=1
ALLOW_UNVERIFIED_PUBLISH=1
PORT=3000
